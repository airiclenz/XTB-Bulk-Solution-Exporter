<Project Sdk="Microsoft.NET.Sdk">

	<!-- UI-free logic shared by the XrmToolBox plugin (net48) and the Power Platform ToolBox worker (net8.0). -->
	<PropertyGroup>
		<TargetFrameworks>net48;net8.0</TargetFrameworks>
		<OutputType>Library</OutputType>
		<RootNamespace>Com.AiricLenz.BulkSolutionExporter.Core</RootNamespace>
		<AssemblyName>Com.AiricLenz.BulkSolutionExporter.Core</AssemblyName>
		<IsPackable>false</IsPackable>
		<DebugType>portable</DebugType>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
		<!-- Same version as the plugin's PackageReference, so the plugin and core bind to one Newtonsoft.Json. -->
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
	</ItemGroup>

</Project>
