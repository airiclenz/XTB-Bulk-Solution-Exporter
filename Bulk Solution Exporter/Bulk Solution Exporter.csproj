<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net48</TargetFramework>
		<OutputType>Library</OutputType>
		<UseWindowsForms>true</UseWindowsForms>
		<RootNamespace>Com.AiricLenz.XTB.Plugin</RootNamespace>
		<AssemblyName>Com.AiricLenz.XTB.Plugin.BulkSolutionExporter</AssemblyName>
		<ProjectGuid>{1CB7EF9B-B7DC-4E6A-8F2F-F97C448B9CD3}</ProjectGuid>
		<!-- Version and assembly attributes live in Properties\AssemblyInfo.cs (checked by Scripts\NuGet Pack.ps1). -->
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<!-- Outputs stay in bin\Debug\ and bin\Release\: the nuspec, Deploy Locally.bat, launch.json and tasks.json depend on it. -->
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<!-- Package assemblies are copied to the output, so bin\Debug holds a runnable XrmToolBox debug host. -->
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<!-- The .NET SDK cannot embed non-string .resx resources the classic way; preserialized resources
		     need System.Resources.Extensions at run time, which ships next to the plugin DLL. -->
		<GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
		<ForceDesignerDPIUnaware>true</ForceDesignerDPIUnaware>
		<ApplicationIcon>bulk solution exporter.ico</ApplicationIcon>
		<DebugType>portable</DebugType>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<!-- Release builds have always defined DEBUG: LogDebug output stays available behind the debug-mode setting. -->
		<DefineConstants>$(DefineConstants);DEBUG</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
		<PackageReference Include="System.Resources.Extensions" Version="8.0.0" />
	</ItemGroup>

