	<Import Project="..\XTB Components\XTB Components.projitems" Label="Shared" />

	<!-- F5 in VS starts bin\Debug\XrmToolBox.exe (Properties\launchSettings.json), which loads the plugin from
	     bin\Debug\Plugins. -->
	<Target Name="CopyPluginToDebugPlugins" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">
		<Copy SourceFiles="$(TargetPath);$(OutDir)$(TargetName).pdb" DestinationFolder="$(OutDir)Plugins" />
	</Target>

